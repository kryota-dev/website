{
  "extends": ["stylelint-config-standard", "stylelint-config-html/astro"],
  "plugins": ["stylelint-declaration-strict-value"],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      [
        "/color$/",
        "fill",
        "stroke",
        "/^(border|outline)-(block|inline)(-(start|end))?$/",
        "box-shadow",
        "text-shadow",
        "/^margin/",
        "/^padding/",
        "/gap$/",
        "/^inset/"
      ],
      {
        "ignoreValues": [
          "0",
          "auto",
          "none",
          "inherit",
          "initial",
          "unset",
          "currentcolor",
          "transparent",
          "Highlight"
        ],
        "expandShorthand": true,
        "recurseLonghand": true,
        "disableFix": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/styles/tokens.css", "src/styles/reset.css"],
      "rules": {
        "scale-unlimited/declaration-strict-value": null
      }
    }
  ]
}
