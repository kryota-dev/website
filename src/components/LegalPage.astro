---
import { getEntry, render } from "astro:content";
import Page from "../layouts/Page.astro";

interface Props {
  id: "privacy";
}

const entry = await getEntry("legal", Astro.props.id);
if (!entry)
  throw new Error(`src/content/legal/${Astro.props.id}.md is missing`);
const { title, description } = entry.data;
const source = `src/content/legal/${Astro.props.id}.md`;
if (!entry.body?.trim()) {
  throw new Error(`${source} must have a body`);
}
const { Content } = await render(entry);
---

<Page title={title} description={description}>
  <article class="legal">
    <h1 class="title">{title}</h1>
    <div class="body">
      <Content />
    </div>
  </article>
</Page>

<style>
  @layer components {
    .legal {
      max-inline-size: 48rem;
      margin-inline: auto;
      padding-block: var(--space-section);
      padding-inline: var(--space-gutter);
    }

    .title {
      margin-block-end: var(--space-8);
      font-size: var(--text-xl);
    }

    .body {
      margin-block-start: var(--space-8);
    }

    /* The Markdown body: space between blocks, more before each heading. */
    .body > :global(* + *) {
      margin-block-start: var(--space-4);
    }

    .body > :global(h2) {
      margin-block-start: var(--space-8);
      font-size: var(--text-lg);
    }
  }
</style>
