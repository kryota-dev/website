---
import { getSingle } from "../lib/content";
import { serializeJsonLd } from "../lib/json-ld";

const site = (await getSingle("site")).data;
const profile = (await getSingle("profile")).data;
if (!Astro.site) throw new Error("`site` must be set in astro.config.mjs");
const url = new URL("/", Astro.site).href;
const personId = `${url}#person`;
const organizationId = `${url}#organization`;
const { person, organization } = site.seo;

// sameAs lists web pages that identify the person, not contact links (mailto:).
const sameAs = profile.links
  .map(({ href }) => href)
  .filter((href) => new URL(href).protocol === "https:");

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${url}#profile-page`,
      url,
      name: site.name,
      mainEntity: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: person.name,
      jobTitle: person.jobTitle,
      url,
      sameAs,
      worksFor: { "@id": organizationId },
    },
    {
      "@type": "Organization",
      "@id": organizationId,
      name: organization.name,
      description: organization.description,
      url,
      founder: { "@id": personId },
      address: {
        "@type": "PostalAddress",
        addressRegion: organization.addressRegion,
        addressCountry: organization.addressCountry,
      },
    },
  ],
};
---

<script type="application/ld+json" set:html={serializeJsonLd(graph)} />
