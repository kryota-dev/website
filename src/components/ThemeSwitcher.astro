---
import { getSingle } from "../lib/content";

const { theme } = (await getSingle("site")).data;

const options = [
  { value: "system", label: theme.system },
  { value: "light", label: theme.light },
  { value: "dark", label: theme.dark },
] as const;
---

<fieldset class="theme-switcher" data-theme-switcher>
  <legend class="visually-hidden">{theme.legend}</legend>
  {options.map(({ value, label }) => (
    <label class="option" title={label}>
      <input
        class="visually-hidden"
        type="radio"
        name="theme"
        value={value}
        checked={value === "system"}
      />
      <svg
        class="icon"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        {value === "system" && (
          <>
            <rect x="3" y="4" width="18" height="12" rx="2" />
            <path d="M8 20h8M12 16v4" />
          </>
        )}
        {value === "light" && (
          <>
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </>
        )}
        {value === "dark" && (
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        )}
      </svg>
      <span class="visually-hidden">{label}</span>
    </label>
  ))}
</fieldset>

<script>
  import {
    applyThemeChoice,
    isThemeChoice,
    readThemeChoice,
    saveThemeChoice,
    type ThemeChoice,
  } from "../scripts/theme";

  /** A transition can be skipped (e.g. switching again before it starts). */
  const SKIPPED_TRANSITION_ERRORS = new Set([
    "AbortError",
    "InvalidStateError",
  ]);

  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function switchTheme(choice: ThemeChoice, origin: Element) {
    if (prefersReducedMotion() || !document.startViewTransition) {
      applyThemeChoice(choice);
      return;
    }
    const rect = origin.getBoundingClientRect();
    const root = document.documentElement;
    root.style.setProperty("--vt-x", `${rect.left + rect.width / 2}px`);
    root.style.setProperty("--vt-y", `${rect.top + rect.height / 2}px`);
    const transition = document.startViewTransition(() =>
      applyThemeChoice(choice),
    );
    transition.ready.catch((error: unknown) => {
      if (
        error instanceof DOMException &&
        SKIPPED_TRANSITION_ERRORS.has(error.name)
      ) {
        return;
      }
      console.error("Theme transition failed:", error);
    });
  }

  const switchers = document.querySelectorAll<HTMLElement>(
    "[data-theme-switcher]",
  );

  /** Reflects the saved choice in the radios (and the page, when asked). */
  function syncFromStorage({ apply }: { apply: boolean }) {
    const current = readThemeChoice();
    if (apply) applyThemeChoice(current);
    for (const switcher of switchers) {
      for (const input of switcher.querySelectorAll<HTMLInputElement>(
        "input[name=theme]",
      )) {
        input.checked = input.value === current;
      }
    }
  }

  syncFromStorage({ apply: false });

  // A page restored from the back/forward cache keeps its old theme;
  // the choice may have changed on another page in the meantime.
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) syncFromStorage({ apply: true });
  });

  for (const switcher of switchers) {
    switcher.addEventListener("change", (event) => {
      const input = event.target;
      if (!(input instanceof HTMLInputElement) || !isThemeChoice(input.value))
        return;
      // When storage is unavailable the choice still applies to this page.
      saveThemeChoice(input.value);
      switchTheme(input.value, input.closest("label") ?? input);
    });
  }
</script>

<style>
  @layer components {
    .theme-switcher {
      display: inline-flex;
      gap: var(--space-1);
      margin: 0;
      padding: var(--space-1);
      border: var(--border-divider);
      border-radius: var(--radius-pill);
      background-color: var(--color-surface);
    }

    :root:not([data-js]) .theme-switcher {
      display: none;
    }

    .option {
      display: inline-grid;
      place-items: center;
      inline-size: 2.25rem;
      block-size: 2.25rem;
      border: 1px solid transparent;
      border-radius: var(--radius-pill);
      color: var(--color-muted);
      cursor: pointer;
      transition:
        background-color var(--duration-fast) var(--ease-out),
        color var(--duration-fast) var(--ease-out);
    }

    .option:hover {
      color: var(--color-text);
    }

    /* The border carries the selected state (>= 3:1); the fill is decoration. */
    .option:has(input:checked) {
      border-color: var(--color-text);
      background-color: var(--color-accent-soft);
      color: var(--color-text);
    }

    @media (forced-colors: active) {
      .option:has(input:checked) {
        border-color: Highlight;
      }
    }

    .option:has(input:focus-visible) {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }
  }
</style>
