---
import { render } from "astro:content";
import { getOrdered } from "../../lib/content";
import Section from "./Section.astro";

// Ordered by `order`: 1 is the most recent work.
const works = await Promise.all(
  (await getOrdered("works")).map(async (entry) => {
    if (!entry.body?.trim()) {
      throw new Error(`src/content/works/${entry.id}.md must have a summary`);
    }
    const { Content } = await render(entry);
    return { id: entry.id, data: entry.data, Content };
  }),
);
---

<Section id="works">
  <ul class="cards" role="list">
    {works.map(({ id, data, Content }) => (
      <li class="card" data-entry={id}>
        <p class="meta">
          <span>{data.industry}</span>
          <span class="period">{data.period}</span>
        </p>
        <h3 class="title">{data.title}</h3>
        <div class="summary">
          <Content />
        </div>
        <dl class="facts">
          <div class="fact">
            <dt>{data.labels.role}</dt>
            <dd>{data.role}</dd>
          </div>
          <div class="fact">
            <dt>{data.labels.highlights}</dt>
            <dd>
              <ul class="highlights">
                {data.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
        <ul class="tags" role="list" aria-label={data.labels.tech}>
          {data.tech.map((tech) => (
            <li class="tag">{tech}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</Section>

<style>
  @layer components {
    .cards {
      display: grid;
      gap: var(--space-6);
      padding: 0;
      list-style: none;
    }

    .card {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-8);
      border: var(--border-divider);
      border-radius: var(--radius-card);
      background-color: var(--color-surface);
      transition:
        transform var(--duration-base) var(--ease-out),
        border-color var(--duration-base) var(--ease-out);
    }

    .card:hover {
      transform: translateY(-4px);
      border-color: var(--color-accent);
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-2);
      color: var(--color-muted);
      font-size: var(--text-xs);
    }

    .period {
      font-family: var(--font-mono);
      letter-spacing: 0;
    }

    .title {
      font-size: var(--text-lg);
    }

    .summary {
      max-inline-size: 40em;
      color: var(--color-muted);
    }

    .facts {
      display: grid;
      gap: var(--space-4);
      font-size: var(--text-sm);
    }

    /* Label beside the value; the value wraps below on narrow screens. */
    .fact {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-4);
    }

    .fact dt {
      flex: 0 0 8rem;
      font-weight: 700;
    }

    .fact dd {
      flex: 1 1 16rem;
      min-inline-size: 0;
      margin: 0;
      color: var(--color-muted);
    }

    .highlights {
      display: grid;
      gap: var(--space-1);
      padding-inline-start: var(--space-6);
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      padding: 0;
      list-style: none;
    }

    .tag {
      padding: var(--space-1) var(--space-3);
      border: var(--border-divider);
      border-radius: var(--radius-pill);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0;
    }
  }
</style>
