---
import { getOrdered } from "../../lib/content";
import Section from "./Section.astro";

const works = await getOrdered("works");
---

<Section id="works">
  <ul class="cards" role="list">
    {works.map(({ id, data }) => (
      <li class="card" data-entry={id}>
        <p class="meta">
          <span>{data.industry}</span>
          <span class="period">{data.period}</span>
        </p>
        <h3 class="title">{data.title}</h3>
        <dl class="facts">
          <div>
            <dt>{data.labels.role}</dt>
            <dd>{data.role}</dd>
          </div>
          <div>
            <dt>{data.labels.result}</dt>
            <dd>{data.result}</dd>
          </div>
        </dl>
        <ul class="tags" role="list" aria-label={data.labels.tech}>
          {data.tech.map((tech) => (
            <li class="tag">{tech}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</Section>

<style>
  @layer components {
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
      gap: var(--space-6);
      padding: 0;
      list-style: none;
    }

    .card {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-8);
      border: var(--border-divider);
      border-radius: var(--radius-card);
      background-color: var(--color-surface);
      transition:
        transform var(--duration-base) var(--ease-out),
        border-color var(--duration-base) var(--ease-out);
    }

    .card:hover {
      transform: translateY(-4px);
      border-color: var(--color-accent);
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-2);
      color: var(--color-muted);
      font-size: var(--text-xs);
    }

    .period {
      font-family: var(--font-mono);
      letter-spacing: 0;
    }

    .title {
      font-size: var(--text-lg);
    }

    .facts {
      display: grid;
      gap: var(--space-2);
      font-size: var(--text-sm);
    }

    .facts div {
      display: flex;
      gap: var(--space-3);
    }

    .facts dt {
      flex-shrink: 0;
      font-weight: 700;
    }

    .facts dd {
      margin: 0;
      color: var(--color-muted);
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-block-start: auto;
      padding: 0;
      list-style: none;
    }

    .tag {
      padding: var(--space-1) var(--space-3);
      border: var(--border-divider);
      border-radius: var(--radius-pill);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0;
    }
  }
</style>
