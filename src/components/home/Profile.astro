---
import { render } from "astro:content";
import { getSingle } from "../../lib/content";
import {
  EXTERNAL_LINK_REL,
  EXTERNAL_LINK_TARGET,
  NEW_TAB_NOTE,
  NEW_TAB_NOTE_CLASS,
  isExternalHref,
} from "../../lib/external-link";
import EntryList from "./EntryList.astro";
import Section from "./Section.astro";
import SubHeading from "./SubHeading.astro";

const profile = await getSingle("profile");
if (!profile.body?.trim()) {
  throw new Error("src/content/profile/index.md must have a summary");
}
const { qualificationsLabel, qualifications, activitiesLabel, activities } =
  profile.data;
const { linksLabel, links } = profile.data;
const hasBlocks = qualifications.length + activities.length + links.length > 0;
const { Content } = await render(profile);
---

<Section id="profile">
  <div class="summary">
    <Content />
  </div>
  {hasBlocks && (
    <div class="blocks">
      <EntryList
        label={qualificationsLabel}
        entries={qualifications.map(({ date, name, note }) => ({
          when: date,
          text: name,
          note,
        }))}
      />
      <EntryList
        label={activitiesLabel}
        entries={activities.map(({ period, title, detail }) => ({
          when: period,
          text: title,
          note: detail,
        }))}
      />
      {links.length > 0 && (
        <div class="block-links">
          <SubHeading>{linksLabel}</SubHeading>
          <ul class="links" role="list">
            {links.map(({ label, href }) => {
              const external = isExternalHref(href);
              return (
                <li>
                  <a
                    class="link"
                    href={href}
                    target={external ? EXTERNAL_LINK_TARGET : undefined}
                    rel={external ? EXTERNAL_LINK_REL.join(" ") : undefined}
                  >
                    {label}
                    {external && (
                      <span class={NEW_TAB_NOTE_CLASS}>{NEW_TAB_NOTE}</span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </div>
  )}
</Section>

<style>
  @layer components {
    .summary {
      max-inline-size: var(--measure-body);
    }

    .blocks {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
      gap: var(--space-8) var(--space-12);
      margin-block-start: var(--space-12);
    }

    .links {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding: 0;
      list-style: none;
    }

    .link {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      font-family: var(--font-mono);
      letter-spacing: 0;
    }
  }
</style>
