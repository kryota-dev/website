---
import { getOrdered } from "../../lib/content";
import Section from "./Section.astro";
import SubHeading from "./SubHeading.astro";

const groups = await getOrdered("skills");
---

<Section id="skills">
  <div class="groups">
    {groups.map(({ id, data }) => (
      <div class="group" data-entry={id}>
        <SubHeading>{data.group}</SubHeading>
        <ul class="items" role="list">
          {data.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>

<style>
  @layer components {
    .groups {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
      gap: var(--space-8) var(--space-12);
    }

    .items {
      padding: 0;
      font-size: var(--text-sm);
      line-height: 2.1;
      list-style: none;
    }
  }
</style>
