---
import { render } from "astro:content";
import { getSingle } from "../../lib/content";

const hero = await getSingle("hero");
const { Content } = await render(hero);
// A line break in the heading is kept as <br> (the copy decides where it breaks).
const headingLines = hero.data.heading.split("\n");
---

<section class="hero" aria-labelledby="hero-heading" data-hero>
  <p class="byline">{hero.data.byline}</p>
  <h1 id="hero-heading" class="heading">
    {headingLines.map((line, index) => (
      <>
        {index > 0 && <br />}
        {line}
      </>
    ))}
  </h1>
  <div class="lead">
    <Content />
  </div>
</section>

<style>
  @layer components {
    .hero {
      max-inline-size: var(--content-max);
      margin-inline: auto;
      padding-block: clamp(4rem, 12vw, 10rem) var(--space-section);
      padding-inline: var(--space-gutter);
    }

    .byline {
      margin-block-end: var(--space-6);
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.04em;
    }

    .heading {
      max-inline-size: 14em;
      font-size: var(--text-hero);
      font-weight: 500;
      letter-spacing: 0.01em;
    }

    .lead {
      max-inline-size: 34em;
      margin-block-start: var(--space-8);
      color: var(--color-muted);
    }
  }
</style>
