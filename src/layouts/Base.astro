---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <!--
      Declare the cascade layer order before any bundled stylesheet.
      Layer order is fixed by first appearance, and bundled component CSS
      can load before global.css. Keep in sync with src/styles/global.css.
    -->
    <style is:inline>
      @layer reset, tokens, base, components;
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-noto-sans-jp" preload />
    <Font cssVariable="--font-ibm-plex-mono" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      // Keep the storage key in sync with src/scripts/theme.ts.
      (() => {
        const root = document.documentElement;
        root.dataset.js = "";
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") root.dataset.theme = saved;
        } catch {
          // Storage is unavailable: fall back to the OS setting.
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
