---
import Base from "../layouts/Base.astro";

const swatches = [
  { name: "bg", token: "--color-bg" },
  { name: "surface", token: "--color-surface" },
  { name: "text", token: "--color-text" },
  { name: "muted", token: "--color-muted" },
  { name: "border", token: "--color-border" },
  { name: "field-border", token: "--color-field-border" },
  { name: "accent", token: "--color-accent" },
  { name: "accent-soft", token: "--color-accent-soft" },
];
---

<Base
  title="kryota.dev"
  description="フリーランスのフロントエンドエンジニア kryota のサイトです。現在準備中です。"
>
  <main class="page">
    <p class="byline">kryota.dev — Design tokens preview</p>
    <h1 class="hero">
      速くて、誰にとっても
      <br />
      使いやすいウェブを。
    </h1>
    <p class="lead">
      このページはデザイントークンを確認するための仮のページです。サイトは現在準備中です。
    </p>

    <section class="section" aria-labelledby="color-h">
      <h2 id="color-h" class="section-title">
        <span class="section-number">01</span>色
      </h2>
      <ul class="swatches">
        {swatches.map(({ name, token }) => (
          <li class="swatch">
            <span
              class="swatch-chip"
              style={`background-color: var(${token})`}
            />
            <code>{name}</code>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="type-h">
      <h2 id="type-h" class="section-title">
        <span class="section-number">02</span>文字
      </h2>
      <p>
        本文は Noto Sans JP、行間 1.9、字間 0.02em、約物は palt
        で詰めます。リンクは<a href="https://github.com/kryota-dev">GitHub</a>
        のように若竹の色で示します。
      </p>
      <p class="muted">補足の文は muted の色で示します。</p>
      <p>
        <code>IBM Plex Mono — 2026 / TypeScript / Astro</code>
      </p>
    </section>
  </main>
</Base>

<style>
  @layer components {
    .page {
      max-inline-size: var(--content-max);
      margin-inline: auto;
      padding-block: var(--space-section);
      padding-inline: var(--space-gutter);
    }

    .byline {
      margin-block-end: var(--space-6);
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.04em;
    }

    .hero {
      max-inline-size: 14em;
      font-size: var(--text-hero);
      font-weight: 700;
      letter-spacing: 0.01em;
    }

    .lead {
      margin-block-start: var(--space-8);
      max-inline-size: 34em;
      color: var(--color-muted);
    }

    .section {
      margin-block-start: var(--space-section);
      padding-block-start: var(--space-section);
      border-block-start: 1px solid var(--color-border);
    }

    .section-title {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      margin-block-end: var(--space-8);
      font-size: var(--text-xl);
    }

    .section-number {
      color: var(--color-accent);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      font-weight: 500;
    }

    .swatches {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
      gap: var(--space-4);
      padding: 0;
      list-style: none;
    }

    .swatch {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-3);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-card);
      background-color: var(--color-surface);
      font-size: var(--text-sm);
    }

    .swatch-chip {
      inline-size: 2.5rem;
      block-size: 2.5rem;
      border: 1px solid var(--color-field-border);
      border-radius: var(--radius-field);
    }

    .muted {
      margin-block-start: var(--space-4);
      color: var(--color-muted);
    }

    .muted + p {
      margin-block-start: var(--space-4);
    }
  }
</style>
